# Пароль для PostgreSQL (придумайте надёжный)
DB_PASSWORD=замените_на_надёжный_пароль

# Секретный ключ для JWT (минимум 32 символа, любая случайная строка)
JWT_SECRET=замените_на_случайный_ключ_минимум_32_символа

# URL фронтенда (для CORS в бэкенде)
FRONTEND_URL=https://antonchernyshov.ru

# URL бэкенда (для фронтенда — то что браузер видит снаружи)
BACKEND_URL=https://antonchernyshov.ru/rost/api

# Подпуть сайта (если CRM на /rost, иначе оставить пустым)
NEXT_BASE_PATH=/rost

# DaData API токен (для поиска ИНН, адресов, банков)
DADATA_TOKEN=ваш_токен_дадата

# Telegram Bot токен (опционально, для уведомлений)
TELEGRAM_BOT_TOKEN=
